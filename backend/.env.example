# Server Configuration (Default 5001 avoids macOS AirPlay receiver on 5000)
PORT=5001
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Frontend Client URL (for CORS allowance in production and development)
CLIENT_URL=http://localhost:5173
